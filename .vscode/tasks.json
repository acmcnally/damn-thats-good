{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "stop-dev-servers",
      "detail": "Stop any api/web dev server left running from a previous run (used by 'dev')",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/stop-dev-servers.sh",
      "problemMatcher": []
    },
    {
      "label": "db",
      "detail": "Start Postgres (wait for healthy) + run migrations",
      "type": "shell",
      "command": "docker compose up -d --wait postgres && pnpm --filter @dtg/db migrate",
      "presentation": { "panel": "dedicated", "group": "dev", "reveal": "always", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "api",
      "detail": "NestJS dev server (tsup --watch)",
      "type": "shell",
      "command": "pnpm --filter @dtg/api dev",
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "web",
      "detail": "Vite dev server",
      "type": "shell",
      "command": "pnpm --filter @dtg/web dev",
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "dev",
      "detail": "Make sure the latest code is running: stops any existing api/web dev servers, then db, then api + web",
      "dependsOrder": "sequence",
      "dependsOn": ["stop-dev-servers", "db", "servers"],
      "problemMatcher": []
    },
    {
      "label": "servers",
      "detail": "api + web in parallel (used by 'dev')",
      "dependsOn": ["api", "web"],
      "problemMatcher": []
    }
  ]
}
