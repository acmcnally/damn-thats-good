# Copy to deploy/.env on the target host, fill in real values, `chmod 600`.
# Keep the canonical copy in the password manager (ADR-0010). deploy/.env is
# gitignored. This example doubles as a working config for local validation.

# Image tag deploy.sh pulls when given no argument.
TAG=latest

# --- Postgres ---
POSTGRES_USER=dtg
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dtg
# The Docker named volume holding the data directory. Staging and prod each use
# their own so a restore drill (DAMN-31) can't touch the wrong one.
PG_VOLUME=dtg_staging_pgdata

# --- App ---
API_PORT=3000
WEB_PORT=8080
# 127.0.0.1: reachable only via `tailscale serve` (the default).
# 0.0.0.0:   also reachable from the LAN (mobile testing).
WEB_BIND=127.0.0.1

# --- WorkOS (placeholder until DAMN-1; the API does not read these yet) ---
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
