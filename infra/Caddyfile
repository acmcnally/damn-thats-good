# Internal reverse proxy for the local Compose stack (ADR-0004).
# TLS is terminated upstream (Cloudflare / Tailscale — undecided), so Caddy here does
# only path routing: /api/* to the NestJS service, everything else to the static SPA.
:8080 {
	handle /api/* {
		# Active health checks against the API's own /api/health so a dead/restarting
		# backend is marked down proactively — requests get a clean, fast 502 instead of
		# hanging on a dial to a host that's mid-restart. The transport timeouts bound
		# the worst case between health-check ticks too.
		reverse_proxy api:3000 {
			health_uri /api/health
			health_interval 5s
			health_timeout 2s
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
