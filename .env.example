# Copy to `.env` (git-ignored) and adjust as needed:  cp .env.example .env
# Local development only — nothing in here is a secret. Real secrets (WorkOS keys,
# tunnel tokens, …) will live in `.env` too but are never committed (ADR-0010).

# --- Postgres (read by docker compose) ---
POSTGRES_USER=dtg
POSTGRES_PASSWORD=dtg_local_dev_only
POSTGRES_DB=dtg
POSTGRES_PORT=5432

# --- App ports ---
API_PORT=3000
WEB_PORT=8080

# --- Database URL (read by the API and the migrate script) ---
# pnpm dev (host):     host is localhost, as below
# docker compose up:   the api / migrate services override the host to "postgres"
DATABASE_URL=postgres://dtg:dtg_local_dev_only@localhost:5432/dtg

# --- WorkOS (DAMN-1) — Staging environment keys; local dev shares Staging's WorkOS
# keys with the deployed staging box (ADR-0010). Get these from the WorkOS dashboard:
# API Keys page for WORKOS_API_KEY, Application/Configuration page for WORKOS_CLIENT_ID.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# --- E2E auth bypass (DAMN-1) — set by e2e/run.ts for the local Playwright stack.
# Never set this by hand for regular `pnpm dev` / `docker compose up` use.
E2E_AUTH_BYPASS=
