# The build does a clean `pnpm install` in-container — never copy host node_modules
# (wrong platform / stale) or build output.
**/node_modules
**/dist
**/*.tsbuildinfo
**/coverage
**/playwright-report
**/test-results

.git
.github
.vscode
.claude
deploy
*.log

# Secrets never enter an image
.env
.env.*
